{
  "targets": [
    {
      "name": "oxdock-readme",
      "out": "oxdock/README.md",
      "values": "oxdock/.oxdock/template/values.json",
      "template": "oxdock/.oxdock/template/README.md.tmpl",
      "fragments": {
        "local": [
          "oxdock/.oxdock/template/fragments/*"
        ],
        "shared": [
          ".oxdock/template/shared/*"
        ],
        "guide": [
          ".oxdock/template/readme/fragments/dsl-reference.md.tmpl",
          ".oxdock/template/readme/fragments/environment.md.tmpl",
          ".oxdock/template/readme/fragments/path-separators.md.tmpl",
          ".oxdock/template/readme/fragments/workspaces.md.tmpl"
        ],
        "generated": [
          ".oxdock/template/readme/generated/*"
        ]
      }
    },
    {
      "name": "oxdock-rustdoc",
      "out": "oxdock/docs/command_reference.md",
      "values": "oxdock/.oxdock/template/values.json",
      "template": "oxdock/.oxdock/template/command_reference.md.tmpl",
      "fragments": {
        "generated": [
          ".oxdock/template/readme/generated/*"
        ]
      }
    },
    {
      "name": "oxdock-crate-docs",
      "out": "oxdock/docs/crate_docs.md",
      "values": "oxdock/.oxdock/template/values.json",
      "template": "oxdock/.oxdock/template/crate_docs.md.tmpl",
      "fragments": {
        "shared": [
          ".oxdock/template/shared/intro.md.tmpl",
          ".oxdock/template/shared/embed-example.md.tmpl",
          ".oxdock/template/shared/inline-macro.md.tmpl"
        ],
        "guide": [
          ".oxdock/template/readme/fragments/dsl-reference.md.tmpl"
        ],
        "generated": [
          ".oxdock/template/readme/generated/*"
        ]
      }
    }
  ]
}
