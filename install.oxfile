# Installs the downloaded OxDock release binary after running cross-platform
# interpreter bootstrapper (install.sh on Unix; install.ps1 on Windows).
# Piped stdin runs instead of installing: the stub saves any piped bytes
# and bridges that file as OXDOCK_PIPED_SCRIPT, and the fetched
# interpreter (bridged as OXDOCK_INTERPRETER) reinvokes itself on that
# script below. Nothing is placed and no destination is derived in run
# mode.

IMPORT [STD]

INHERIT_ENV [OXDOCK_ASSET, OXDOCK_SHA, OXDOCK_BIN, OXDOCK_DIR, OXDOCK_VERSION, OXDOCK_PIPED_SCRIPT, OXDOCK_INTERPRETER, OXDOCK_INTERACTIVE]
[family:unix] INHERIT_ENV [HOME]
[family:windows] INHERIT_ENV [USERPROFILE]

# Full filesystem access: installation writes outside any workspace.
WORKSPACE SYSTEM

# Run vs install is decided here, never in the stub: a non-empty piped
# script bridge means execute it with the fetched interpreter.
LET $piped: STRING = "{{ env:OXDOCK_PIPED_SCRIPT }}"
IF $piped != "" {
    RUN ["{{ env:OXDOCK_INTERPRETER }}", "{{ env:OXDOCK_PIPED_SCRIPT }}"]
} ELSE {
    # Install locations arrive through the stub environment. HOME and
    # USERPROFILE ride along for fix suggestions: the stub never sets
    # them, the host supplies them.
    LET $asset: STRING = "{{ env:OXDOCK_ASSET }}"
    LET $want: STRING = "{{ env:OXDOCK_SHA }}"
    LET $bin: STRING = "{{ env:OXDOCK_BIN }}"
    LET $dir: STRING = "{{ env:OXDOCK_DIR }}"
    # Interactive consoles confirm the destination: the stub exports
    # OXDOCK_INTERACTIVE only with a console behind stdin, and PROMPT
    # itself refuses non-TTY stdin as backstop. The outer LET above owns
    # $dir, so PROMPT mutates it in place; the loop retries until the
    # path is a writable dir or a creatable absence, then INSTALL below
    # stays fail-closed regardless.
    IF "{{ env:OXDOCK_INTERACTIVE }}" != "" {
        PROMPT $dir "Install destination?" "{{ env:OXDOCK_DIR }}"
        WHILE true {
            LET $kind: STRING = PATH_TYPE($dir)
            LET $writable: BOOL = PATH_WRITABLE($dir)
            IF $kind == "dir" || $kind == "absent" {
                IF $writable {
                    BREAK
                }
            }
            PROMPT $dir "Install destination?"
        }
    }
    IF $dir == "" {
        [family:unix] LET $home: STRING = "{{ env:HOME }}"
        [family:windows] LET $home: STRING = "{{ env:USERPROFILE }}"
        IF $home == "" {
            [family:unix] ECHO "no install directory: HOME is unset, so set INSTALL_DIR (example: INSTALL_DIR=\"$HOME/.local/bin\")"
            [family:windows] ECHO "no install directory: USERPROFILE is unset, so set INSTALL_DIR (example: $env:INSTALL_DIR = \"%LOCALAPPDATA%\Microsoft\WindowsApps\")"
            EXIT 1
        }
        [family:unix] ECHO "no install directory: set INSTALL_DIR (example: INSTALL_DIR=\"$HOME/.local/bin\")"
        [family:windows] ECHO "no install directory: set INSTALL_DIR (example: $env:INSTALL_DIR = \"%LOCALAPPDATA%\Microsoft\WindowsApps\")"
        EXIT 1
    }

    # Refuse to place anything the checksum rejects.
    LET $actual: STRING = HASH_SHA256 $asset
    # The digest command terminates its line: the comparison includes it.
    # Rust never emits \r\n here on any platform, so this is exact.
    ASSERT_EQ $actual "{{ $want }}\n"

    # Place the verified binary and report where it landed.
    LET $dest: STRING = "{{ $dir }}/oxdock"
    [family:windows] $dest = "{{ $dir }}/oxdock.exe"
    INSTALL $bin $dest
    ECHO "installed oxdock {{ env:OXDOCK_VERSION }} to {{ $dir }}"
    ECHO "ensure {{ $dir }} is on PATH"
}
