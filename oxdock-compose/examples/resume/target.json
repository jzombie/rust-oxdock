{
  "targets": [
    {
      "name": "resume-md",
      "out": "oxdock-compose/examples/resume/resume.md",
      "values": "oxdock-compose/examples/resume/values.json",
      "template": "oxdock-compose/examples/resume/resume.md.tmpl",
      "fragments": {
        "sec": [
          "oxdock-compose/examples/resume/fragments/sec/*.md.tmpl"
        ]
      }
    },
    {
      "name": "resume-jsonld",
      "out": "oxdock-compose/examples/resume/resume.jsonld",
      "values": "oxdock-compose/examples/resume/values.json",
      "template": "oxdock-compose/examples/resume/resume.jsonld.tmpl",
      "fragments": {
        "data": [
          "oxdock-compose/examples/resume/fragments/data/*.tmpl"
        ]
      }
    }
  ]
}
