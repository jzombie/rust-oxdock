# Generic lifecycle: the engine's own provider for every stage.
#
# Every lifecycle plugin exposes these same methods; registration
# order decides which plugin runs first within a stage.
#
# Domain pipelines add their own plugin file beside this one instead
# of editing it: scope key names and the version env name come from
# the config, never from this file.
IMPORT [STD, COMPOSE_ENGINE, DEFER]
IMPORT [TYPE CTX FROM "../types.oxfile"]

# Run-once intake: generic passthrough. A domain pipeline that needs
# intake work registers its own plugin file providing SETUP.
FUNC SETUP($ctx: CTX) {
    RETURN $ctx
}

# INGEST hook: fail closed on an incomplete target descriptor.
FUNC INGEST($ctx: CTX) {
    LET $target: STRING = $ctx.target
    IF $target == "" {
        ECHO "ingest: target name is empty"
        EXIT 1
    }
    LET $template: STRING = $ctx.template
    IF $template == "" {
        ECHO "ingest: target '{{ $target }}' has no template"
        EXIT 1
    }
    LET $out: STRING = $ctx.out
    IF $out == "" {
        ECHO "ingest: target '{{ $target }}' has no out"
        EXIT 1
    }
    LET $values: STRING = $ctx.values
    IF $values == "" {
        ECHO "ingest: target '{{ $target }}' has no values"
        EXIT 1
    }
    RETURN $ctx
}

# ASSEMBLE hook: expand every fragment once into the staging manifest.
# Fragment groups and stems are user data, so the manifest maps stay
# open here; the lifecycle boundary itself (CTX) stays exact. The
# workspace snapshot below is optional staging data (written by
# whatever intake hook the pipeline registers); when absent, scope
# carries only the configured maps and templates referencing the
# snapshot fail at expansion instead of rendering empty.
FUNC ASSEMBLE($ctx: CTX) {
    LET $cfg: MAP<ANY> = LOAD_JSON($ctx.config)
    LET $has_vars: BOOL = HAS_KEY($cfg, "vars")
    IF $has_vars == false {
        ECHO "assemble: config needs a 'vars' map declaring scope key names"
        EXIT 1
    }
    LET $vars: MAP<ANY> = $cfg.vars
    LET $has_global: BOOL = HAS_KEY($vars, "global")
    IF $has_global == false {
        ECHO "assemble: config 'vars' needs a 'global' scope key name"
        EXIT 1
    }
    LET $vglobal: STRING = $vars.global
    LET $has_vctx: BOOL = HAS_KEY($vars, "ctx")
    IF $has_vctx == false {
        ECHO "assemble: config 'vars' needs a 'ctx' scope key name"
        EXIT 1
    }
    LET $vctx: STRING = $vars.ctx
    LET $wspt: STRING = PATH_TYPE("{{ $ctx.staging }}/_workspace.json")
    LET $has_ws: BOOL = $wspt == "file"
    LET $vkey: STRING = ""
    LET $vpkg: STRING = ""
    IF $has_ws {
        LET $has_vkey: BOOL = HAS_KEY($cfg, "version_key")
        IF $has_vkey == false {
            ECHO "assemble: staging snapshot present but config lacks 'version_key'"
            EXIT 1
        }
        $vkey = $cfg.version_key
        LET $has_vpkg: BOOL = HAS_KEY($vars, "workspace_pkg")
        IF $has_vpkg == false {
            ECHO "assemble: staging snapshot present but config 'vars' lacks 'workspace_pkg'"
            EXIT 1
        }
        $vpkg = $vars.workspace_pkg
    }
    LET $docs_global: MAP<ANY> = LOAD_JSON($ctx.globals)
    LET $docs_ctx: MAP<ANY> = LOAD_JSON($ctx.values)
    LET $ws_version: STRING = ""
    LET $ws_pkg: MAP<ANY> = {}
    IF $has_ws {
        LET $ws: MAP<ANY> = LOAD_JSON("{{ $ctx.staging }}/_workspace.json")
        $ws_version = $ws.version
        $ws_pkg = $ws.package
    }
    LET $manifest: MAP<ANY> = {}
    LET $fragments: MAP<ANY> = PARSE_JSON($ctx.fragments)
    FOR $group: STRING, $patterns: LIST<ANY> IN $fragments {
        LET $group_map: MAP<ANY> = {}
        FOR $pattern: STRING IN $patterns {
            LET $abs: STRING = "{{ $ctx.wsroot }}/{{ $pattern }}"
            FOR $file_rel: STRING IN GLOB($abs) {
                LET $stem: STRING = COMPOSE_ENGINE::FILE_STEM($file_rel)
                LET $dup: BOOL = HAS_KEY($group_map, $stem)
                IF $dup {
                    ECHO "target '{{ $ctx.target }}': '{{ $stem }}' matches more than one file; placeholders must resolve to exactly one"
                    EXIT 1
                }
                LET $raw: STRING = READ "{{ $ctx.wsroot }}/{{ $file_rel }}"
                LET $scope: MAP<ANY> = {}
                $scope = MAP_SET($scope, $vglobal, $docs_global)
                $scope = MAP_SET($scope, $vctx, $docs_ctx)
                LET $envmap: MAP<ANY> = {}
                IF $has_ws {
                    $scope = MAP_SET($scope, $vpkg, $ws_pkg)
                    $envmap = MAP_SET($envmap, $vkey, $ws_version)
                }
                LET $expanded: STRING = COMPOSE_ENGINE::EXPAND_TEMPLATE($raw, $scope, $envmap)
                $group_map = MAP_SET($group_map, $stem, $expanded)
            }
        }
        $manifest = MAP_SET($manifest, $group, $group_map)
    }
    LET $json: STRING = TO_JSON($manifest)
    WRITE "{{ $ctx.staging }}/{{ $ctx.target }}.json" $json
    RETURN $ctx
}

# RENDER hook: expand the master template over the manifest scope.
# User data stays in open maps; the CTX boundary stays exact. Scope
# key names and the version env name come from the config, never
# from this file. The workspace snapshot below is optional staging
# data (see ASSEMBLE); when absent, scope carries only the
# configured maps.
FUNC RENDER($ctx: CTX) {
    LET $cfg: MAP<ANY> = LOAD_JSON($ctx.config)
    LET $has_vars: BOOL = HAS_KEY($cfg, "vars")
    IF $has_vars == false {
        ECHO "render: config needs a 'vars' map declaring scope key names"
        EXIT 1
    }
    LET $vars: MAP<ANY> = $cfg.vars
    LET $has_global: BOOL = HAS_KEY($vars, "global")
    IF $has_global == false {
        ECHO "render: config 'vars' needs a 'global' scope key name"
        EXIT 1
    }
    LET $vglobal: STRING = $vars.global
    LET $has_vctx: BOOL = HAS_KEY($vars, "ctx")
    IF $has_vctx == false {
        ECHO "render: config 'vars' needs a 'ctx' scope key name"
        EXIT 1
    }
    LET $vctx: STRING = $vars.ctx
    LET $wspt: STRING = PATH_TYPE("{{ $ctx.staging }}/_workspace.json")
    LET $has_ws: BOOL = $wspt == "file"
    LET $vkey: STRING = ""
    LET $vpkg: STRING = ""
    IF $has_ws {
        LET $has_vkey: BOOL = HAS_KEY($cfg, "version_key")
        IF $has_vkey == false {
            ECHO "render: staging snapshot present but config lacks 'version_key'"
            EXIT 1
        }
        $vkey = $cfg.version_key
        LET $has_vpkg: BOOL = HAS_KEY($vars, "workspace_pkg")
        IF $has_vpkg == false {
            ECHO "render: staging snapshot present but config 'vars' lacks 'workspace_pkg'"
            EXIT 1
        }
        $vpkg = $vars.workspace_pkg
    }
    LET $docs_global: MAP<ANY> = LOAD_JSON($ctx.globals)
    LET $docs_ctx: MAP<ANY> = LOAD_JSON($ctx.values)
    LET $files: MAP<ANY> = LOAD_JSON("{{ $ctx.staging }}/{{ $ctx.target }}.json")
    LET $scope: MAP<ANY> = {}
    $scope = MAP_SET($scope, $vglobal, $docs_global)
    $scope = MAP_SET($scope, $vctx, $docs_ctx)
    $scope = MAP_SET($scope, "files", $files)
    LET $envmap: MAP<ANY> = {}
    IF $has_ws {
        LET $ws: MAP<ANY> = LOAD_JSON("{{ $ctx.staging }}/_workspace.json")
        LET $ws_version: STRING = $ws.version
        LET $ws_pkg: MAP<ANY> = $ws.package
        $scope = MAP_SET($scope, $vpkg, $ws_pkg)
        $envmap = MAP_SET($envmap, $vkey, $ws_version)
    }
    LET $raw: STRING = READ $ctx.template
    LET $text: STRING = COMPOSE_ENGINE::EXPAND_TEMPLATE($raw, $scope, $envmap)
    LET $raw_ends: BOOL = STD::TEXT_ENDS_WITH($raw, "\n")
    IF $raw_ends {
        LET $text_ends: BOOL = STD::TEXT_ENDS_WITH($text, "\n")
        IF $text_ends == false {
            $text = "{{ $text }}\n"
        }
    }
    IF $text == "" {
        ECHO "render: target '{{ $ctx.target }}' rendered empty"
        EXIT 1
    }
    WRITE $ctx.out $text
    RETURN {wsroot: $ctx.wsroot, config: $ctx.config, staging: $ctx.staging, globals: $ctx.globals, target: $ctx.target, template: $ctx.template, out: $ctx.out, values: $ctx.values, fragments: $ctx.fragments, text: $text, exec: $ctx.exec}
}

# DEFERRED hook: expand deferred sentinels against the full text.
FUNC DEFERRED($ctx: CTX) {
    LET $text: STRING = $ctx.text
    LET $final: STRING = DEFER::EXPAND_DEFERRED($text)
    RETURN {wsroot: $ctx.wsroot, config: $ctx.config, staging: $ctx.staging, globals: $ctx.globals, target: $ctx.target, template: $ctx.template, out: $ctx.out, values: $ctx.values, fragments: $ctx.fragments, text: $final, exec: $ctx.exec}
}

# WRITE hook: the only stage that touches the output file. When the
# target declares `"executable": true` the bit lands here, in the
# stage that owns the output, not in a post-pass.
FUNC WRITE_OUT($ctx: CTX) {
    WRITE $ctx.out $ctx.text
    IF $ctx.exec {
        SET_EXECUTABLE $ctx.out
    }
    RETURN $ctx
}

# VERIFY hook: the output on disk must equal the piped text.
FUNC VERIFY($ctx: CTX) {
    LET $disk: STRING = READ $ctx.out
    IF $disk != $ctx.text {
        ECHO "verify: target '{{ $ctx.target }}' drifted between pipe and disk"
        EXIT 1
    }
    RETURN $ctx
}

EXPORT [SETUP, INGEST, ASSEMBLE, RENDER, DEFERRED, WRITE_OUT, VERIFY]
