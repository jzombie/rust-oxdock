# Stage order registry: the single source of lifecycle order.
# The composer reads it through STAGES() and unrolls qualified hook
# calls into the child in the same order, so there is nothing to
# drift. INGEST validates the target descriptor before any glob
# runs; SCAN discovers plus expands fragments into the staging
# source manifest; ASSEMBLE promotes it. The child never imports
# this file: it receives the unrolled calls, never stubs.
FUNC STAGES() {
    RETURN ["INGEST", "SCAN", "ASSEMBLE", "RENDER", "DEFERRED", "WRITE_OUT", "VERIFY"]
}

EXPORT STAGES
