{
  "targets": [
    {
      "name": "tiny-readme",
      "base": "oxdock-render/examples/generic-readme",
      "out": "README.md",
      "values": "values.json",
      "template": "README.md.tmpl",
      "fragments": {
        "sec": [
          "fragments/sec/*.md.tmpl"
        ]
      }
    },
    {
      "name": "tiny-llms",
      "base": "oxdock-render/examples/generic-readme",
      "out": "llms.txt",
      "values": "values.json",
      "template": "llms.txt.tmpl",
      "fragments": {
        "sec": [
          "fragments/sec/*.md.tmpl"
        ]
      }
    },
    {
      "name": "tiny-llms-full",
      "base": "oxdock-render/examples/generic-readme",
      "out": "llms-full.txt",
      "values": "values.json",
      "template": "llms-full.txt.tmpl",
      "fragments": {
        "sec": [
          "fragments/sec/*.md.tmpl"
        ]
      }
    }
  ]
}
