# Assembly before dispatch: leaf FUNCs only, no nested calls.
# The registry names hook files; the stage order comes from the
# stages file's STAGES() and is unrolled into the child, so the order
# lives in exactly one place. Every child-runtime placeholder below
# is escaped: unescaped braces bake at render time, escaped ones
# survive for the child. Paths ride forward slashes: the child text
# passes through a pipe that unescapes backslashes, so the backslash
# gate fails fast naming the violator instead of a corrupted path.
IMPORT [STD]
IMPORT [TYPE PLUGIN, TYPE TARGET, TYPE TARGET_FILE, TYPE LIFECYCLE_REF FROM "types.oxfile"]

FUNC RENDER_ALL($plugins: LIST<STRING>, $stages: LIST<STRING>, $types: STRING): STRING {
    LET $clean: BOOL = STD::TEXT_CONTAINS($types, "\\")
    IF $clean {
        ECHO "types path '{{ $types }}' uses backslashes; use forward slashes"
        EXIT 1
    }
    LET $entries: LIST<PLUGIN> = []
    FOR $path: STRING IN $plugins {
        LET $bad: BOOL = STD::TEXT_CONTAINS($path, "\\")
        IF $bad {
            ECHO "plugin path '{{ $path }}' uses backslashes; use forward slashes"
            EXIT 1
        }
        LET $parts: LIST<STRING> = STD::TEXT_SPLIT($path, "/")
        LET $stem: STRING = ""
        FOR $part: STRING IN $parts {
            $stem = $part
        }
        LET $bare: STRING = STD::TEXT_TRIM_SUFFIX($stem, ".oxfile")
        LET $up: STRING = STD::TEXT_TO_UPPER($bare)
        LET $qual: STRING = "{{ $up }}_HOOKS"
        LET $dup: BOOL = false
        LET $dupe: STRING = ""
        FOR $e: PLUGIN IN $entries {
            LET $eq: STRING = $e.as
            IF $eq == $qual {
                $dup = true
                $dupe = $e.path
            }
        }
        IF $dup {
            ECHO "plugins '{{ $dupe }}' and '{{ $path }}' share qualifier '{{ $qual }}'; rename one file"
            EXIT 1
        }
        LET $entry: PLUGIN = {as: $qual, path: $path}
        LIST_APPEND $entries $entry
    }
    LET $imports: STRING = ""
    FOR $e: PLUGIN IN $entries {
        LET $ip: STRING = $e.path
        LET $iq: STRING = $e.as
        $imports = "{{ $imports }}IMPORT [\"{{ $ip }}\" AS {{ $iq }}]\n"
    }
    LET $per_target: STRING = ""
    FOR $stage: STRING IN $stages {
        FOR $e: PLUGIN IN $entries {
            LET $tq: STRING = $e.as
            $per_target = "{{ $per_target }}    $ctx = {{ $tq }}::{{ $stage }}($ctx)\n"
        }
    }
    LET $setup: STRING = ""
    FOR $e: PLUGIN IN $entries {
        LET $sq: STRING = $e.as
        $setup = "{{ $setup }}$run = {{ $sq }}::SETUP($run)\n"
    }
    LET $mod: STRING = """
        INHERIT_ENV [RENDER_CONFIG, OXDOCK_WORKSPACE_ROOT]
        WORKSPACE LOCAL
        IMPORT [STD, RENDER_ENGINE]
        IMPORT [TYPE CTX, TYPE TARGET, TYPE TARGET_FILE FROM "{{ $types }}"]
        {{ $imports }}LET $cfgpath: STRING = "\{{ env:RENDER_CONFIG }}"
        LET $wsroot: STRING = "\{{ env:OXDOCK_WORKSPACE_ROOT }}"
        LET $cfg: MAP<ANY> = LOAD_JSON($cfgpath)
        LET $staging_rel: STRING = "target/oxdock-render"
        IF HAS_KEY($cfg, "staging_dir") {
            $staging_rel = $cfg.staging_dir
        }
        LET $staging: STRING = "\{{ $wsroot }}/\{{ $staging_rel }}"
        LET $policy: STRING = "fail_on_duplicate"
        IF HAS_KEY($cfg, "merge_policy") {
            $policy = $cfg.merge_policy
        }
        LET $gvpaths: LIST<ANY> = []
        IF TYPE_OF($cfg.global_values) == "LIST" {
            $gvpaths = $cfg.global_values
        } ELSE {
            LIST_APPEND $gvpaths $cfg.global_values
        }
        LET $gvmaps: LIST<ANY> = []
        FOR $vp: STRING IN $gvpaths {
            LET $one: MAP<ANY> = LOAD_JSON($vp)
            LIST_APPEND $gvmaps $one
        }
        LET $global_map: MAP<ANY> = STD::MERGE_MAPS($gvmaps, $policy)
        LET $gjson: STRING = TO_JSON($global_map)
        WRITE "\{{ $staging }}/_globals.json" $gjson
        LET $run: CTX = {wsroot: $wsroot, config: $cfgpath, staging: $staging, globals: "\{{ $staging }}/_globals.json", exec: false}
        {{ $setup }}LET $seen: MAP<ANY> = {}
        LET $count: INT = 0
        FOR $scope: STRING IN $cfg.scopes {
            FOR $tj: STRING IN GLOB("\{{ $scope }}/**/target.json") {
                LET $file: TARGET_FILE = LOAD_JSON($tj)
                FOR $t: TARGET IN $file.targets {
                    LET $tname: STRING = $t.name
                    IF HAS_KEY($seen, $tname) {
                        ECHO "duplicate target name '\{{ $tname }}' (in \{{ $tj }})"
                        EXIT 1
                    }
                    $seen = MAP_SET($seen, $tname, $tj)
                    $count = $count + 1
                    IF HAS_KEY($t, "globs") {
                        ECHO "target '\{{ $t.name }}' still uses 'globs'; declare 'template' and grouped 'fragments' patterns instead"
                        EXIT 1
                    }
                    LET $name: STRING = $t.name
                    LET $exec: BOOL = false
                    IF HAS_KEY($t, "executable") {
                        LET $has_out: BOOL = HAS_KEY($t, "out")
                        IF $has_out == false {
                            ECHO "target '\{{ $tname }}' sets 'executable' without a string 'out'"
                            EXIT 1
                        }
                        IF TYPE_OF($t.executable) != "BOOL" {
                            ECHO "target '\{{ $tname }}' sets 'executable' to a non-boolean; use true or omit it"
                            EXIT 1
                        }
                        $exec = $t.executable
                    }
                    LET $template: STRING = $t.template
                    LET $out: STRING = $t.out
                    LET $values: STRING = $t.values
                    LET $fragments: MAP<ANY> = $t.fragments
                    # Explicit per-target base: when set, relative
                    # template, values, fragment patterns, and out all
                    # resolve under it (base itself stays
                    # wsroot-relative). Wsroot-anchored paths
                    # (`.oxdock/...`, `/...`) stay as-is so shared
                    # fragments keep working. No base means no prefix,
                    # exactly the old behavior.
                    LET $base: STRING = ""
                    IF HAS_KEY($t, "base") {
                        $base = $t.base
                    }
                    IF $base != "" {
                        LET $babs: STRING = "\{{ $wsroot }}/\{{ $base }}"
                        LET $bkind: STRING = PATH_TYPE($babs)
                        IF $bkind != "dir" {
                            ECHO "target '\{{ $tname }}' base '\{{ $base }}' is not a directory (found: \{{ $bkind }})"
                            EXIT 1
                        }
                        LET $rooted_t: BOOL = STD::TEXT_STARTS_WITH($template, ".oxdock/") || STD::TEXT_STARTS_WITH($template, "/")
                        IF $rooted_t == false {
                            $template = "\{{ $base }}/\{{ $template }}"
                        }
                        LET $rooted_v: BOOL = STD::TEXT_STARTS_WITH($values, ".oxdock/") || STD::TEXT_STARTS_WITH($values, "/")
                        IF $rooted_v == false {
                            $values = "\{{ $base }}/\{{ $values }}"
                        }
                        LET $rooted_o: BOOL = STD::TEXT_STARTS_WITH($out, ".oxdock/") || STD::TEXT_STARTS_WITH($out, "/")
                        IF $rooted_o == false {
                            $out = "\{{ $base }}/\{{ $out }}"
                        }
                        LET $prefixed: MAP<ANY> = {}
                        FOR $group: STRING, $patterns: LIST<STRING> IN $fragments {
                            LET $plist: LIST<STRING> = []
                            FOR $pattern: STRING IN $patterns {
                                LET $rooted: BOOL = STD::TEXT_STARTS_WITH($pattern, ".oxdock/") || STD::TEXT_STARTS_WITH($pattern, "/")
                                IF $rooted {
                                    LIST_APPEND $plist $pattern
                                } ELSE {
                                    LIST_APPEND $plist "\{{ $base }}/\{{ $pattern }}"
                                }
                            }
                            $prefixed = MAP_SET($prefixed, $group, $plist)
                        }
                        $fragments = $prefixed
                    }
                    LET $tabs: STRING = "\{{ $wsroot }}/\{{ $template }}"
                    LET $oabs: STRING = "\{{ $wsroot }}/\{{ $out }}"
                    LET $vabs: STRING = "\{{ $wsroot }}/\{{ $values }}"
                    LET $fjson: STRING = TO_JSON($fragments)
                    LET $ctx: CTX = {wsroot: $wsroot, config: $cfgpath, staging: $staging, globals: "\{{ $staging }}/_globals.json", target: $name, template: $tabs, out: $oabs, values: $vabs, fragments: $fjson, exec: $exec}
                    ECHO "rendering \{{ $name }} -> \{{ $out }}"
        {{ $per_target }}        }
            }
        }
        IF $count == 0 {
            ECHO "no targets discovered under the configured scopes; check 'scopes' in \{{ $cfgpath }}"
            EXIT 1
        }
        """
    RETURN $mod
}

EXPORT RENDER_ALL

# Lifecycle files from the config, or the engine's own lifecycle
# files when the config names none. Entries stay plain paths: every
# plugin file exposes the same lifecycle methods, so registration
# order is execution order and there is nothing else to declare.
# The default pair is scanner plus generic: discovery plus
# expansion first, manifest promotion second. A pipeline naming its
# own files owns the whole list, scanner included.
FUNC LIFECYCLE_FILES_WITH_DEFAULT($cfg: MAP<ANY>): LIST<STRING> {
    LET $paths: LIST<STRING> = ["oxdock-render/src/lifecycle/scanner.oxfile", "oxdock-render/src/lifecycle/generic.oxfile"]
    LET $has_lc: BOOL = HAS_KEY($cfg, "lifecycle")
    IF $has_lc {
        LET $lc: LIFECYCLE_REF = $cfg.lifecycle
        LET $has_p: BOOL = HAS_KEY($lc, "files")
        IF $has_p {
            $paths = $lc.files
        }
    }
    RETURN $paths
}

FUNC TYPES_WITH_DEFAULT($cfg: MAP<ANY>): STRING {
    LET $has_lc: BOOL = HAS_KEY($cfg, "lifecycle")
    IF $has_lc == false {
        RETURN "oxdock-render/src/types.oxfile"
    }
    LET $lc: LIFECYCLE_REF = $cfg.lifecycle
    LET $has_t: BOOL = HAS_KEY($lc, "types")
    IF $has_t == false {
        RETURN "oxdock-render/src/types.oxfile"
    }
    LET $t: STRING = $lc.types
    RETURN $t
}

EXPORT LIFECYCLE_FILES_WITH_DEFAULT
EXPORT TYPES_WITH_DEFAULT
