# File imports load another script as an isolated pipeline: the alias
# becomes the namespace, the import's RETURN value is the only channel
# back, and nothing leaks across the boundary. Brackets mix module and
# file entries across lines; each file entry runs in order.
# WORKSPACE LOCAL first: the libs are written by this script, so they
# must land where relative imports resolve (the workspace side).
WORKSPACE LOCAL
WRITE lib.oxdock 'FUNC DOUBLE($x: STRING) { RETURN $x }'
WRITE lib_value.oxdock 'RETURN "lib-value"'
WRITE helpers.oxdock 'FUNC HELPER($x: STRING) { RETURN $x }'
IMPORT [STD,
        "lib.oxdock" AS LIB]
LET $d: STRING = LIB::DOUBLE("hi")
ASSERT_EQ $d "hi"
LET $r: STRING = IMPORT ["lib_value.oxdock" AS LIB2]
ASSERT_EQ $r "lib-value"
IMPORT [[HELPER FROM "helpers.oxdock"]]
LET $h: STRING = HELPER("yo")
ASSERT_EQ $h "yo"
