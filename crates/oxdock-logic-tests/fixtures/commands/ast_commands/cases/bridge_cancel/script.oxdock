# CANCEL of an accept-blocked listener returns promptly: no client ever
# connects, so the acceptor only ever sees the cancellation token.
LET $req: PIPE
LET $resp: PIPE
LET $ls: HANDLE = ASYNC {
  WITH_IO [stdin=$req, stdout=$resp] LISTEN 127.0.0.1:{{ env:BRIDGE_PORT }}
}
SLEEP 500ms
CANCEL $ls
WRITE "done.txt" "cancelled"
