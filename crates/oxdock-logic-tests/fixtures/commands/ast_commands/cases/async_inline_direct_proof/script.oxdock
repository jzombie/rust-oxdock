# PROOF OF UNBRACED INLINE CONCURRENCY:
# Line 1: 'ASYNC WRITE' wraps a single instruction directly (NO BRACES {}).
# 'WRITE' consumes stdin from 'in_chan' until EOF.
LET $in_chan: PIPE
LET $task: HANDLE = WITH_IO [stdin=$in_chan] ASYNC WRITE "inline_direct.txt"

# Line 2: Main thread executes concurrently, sending payload and EOF to unblock Line 1.
WITH_IO [stdout=$in_chan] ECHO "unblock_inline_payload"

# Line 3: AWAIT synchronizes completion; READ verifies output.
AWAIT $task
READ "inline_direct.txt"
