# Proves multiple ASYNC tasks run concurrently:
# 1. Two background tasks write to separate pipes
# 2. Foreground reads both pipes and writes to files
# 3. AWAIT ensures both complete
# 4. If tasks were sequential, pipe reads would deadlock

LET $pipe1: PIPE
LET $pipe2: PIPE
LET $task1: HANDLE = ASYNC {
    WITH_IO [stdout=$pipe1] ECHO "output1"
}
LET $task2: HANDLE = ASYNC {
    WITH_IO [stdout=$pipe2] ECHO "output2"
}
WITH_IO [stdin=$pipe1] WRITE file1.txt
WITH_IO [stdin=$pipe2] WRITE file2.txt
AWAIT $task1
AWAIT $task2
READ file1.txt
READ file2.txt
