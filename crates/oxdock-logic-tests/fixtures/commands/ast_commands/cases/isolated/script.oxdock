ENV OUTER_CUSTOM=outer-val
ENV OUTER_SECRET=top-secret
LET $secret: STRING = "{{ env:OUTER_SECRET }}"
FUNC READ_SECRET($secret: STRING): STRING {
    RETURN $secret
}
ISOLATED {
    INHERIT_ENV [OUTER_CUSTOM]
    ECHO "inner:{{ env:OUTER_CUSTOM }}"
    LET $s: STRING = READ_SECRET($secret)
    ECHO "secret:{{ $s }}"
}
ECHO "top:{{ env:OUTER_CUSTOM }}"
