# Explicit-port listener with a dial-back client: asserts the listener
# observes the client's bytes. The session ends via CANCEL (the listener's
# stdin pipe has no writer by design), which also exercises cancel teardown.
LET $req: PIPE
LET $resp: PIPE
LET $req2: PIPE
LET $resp2: PIPE
LET $ls: HANDLE = ASYNC {
  WITH_IO [stdin=$req, stdout=$resp] LISTEN 127.0.0.1:{{ env:BRIDGE_PORT }}
}
SLEEP 1s
LET $t: HANDLE = ASYNC {
  WITH_IO [stdin=$req2, stdout=$resp2] CONNECT 127.0.0.1:{{ env:BRIDGE_PORT }}
}
WITH_IO [stdout=$req2] ECHO "ping"
WITH_IO [stdin=$resp] READ_LINE $got
CANCEL $ls
AWAIT $t
WRITE "got.txt" "{{ $got }}"
