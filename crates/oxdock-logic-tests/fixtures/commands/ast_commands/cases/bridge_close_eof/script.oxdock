# Graceful teardown sequencing: the dialer completes first (its stdin EOFs
# and the listener half-closes), then the listener drains to EOF and
# completes. Both AWAITs returning proves close maps to EOF with no hangs.
LET $req: PIPE
LET $resp: PIPE
LET $req2: PIPE
LET $resp2: PIPE
LET $ls: HANDLE = ASYNC {
  WITH_IO [stdin=$req, stdout=$resp] LISTEN 127.0.0.1:{{ env:BRIDGE_PORT }}
}
SLEEP 1s
LET $t: HANDLE = ASYNC {
  WITH_IO [stdin=$req2, stdout=$resp2] CONNECT 127.0.0.1:{{ env:BRIDGE_PORT }}
}
WITH_IO [stdout=$req2] ECHO "hi"
WITH_IO [stdin=$resp] READ_LINE $got
WITH_IO [stdout=$req] ECHO "bye"
WITH_IO [stdin=$resp2] READ_LINE $back
AWAIT $t
AWAIT $ls
WRITE "got.txt" "{{ $got }}"
WRITE "back.txt" "{{ $back }}"
