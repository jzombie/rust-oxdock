# Pipes travel into functions as typed arguments and are usable as
# binding targets in both directions. Two syntax rules to remember:
#   - `LET $p: PIPE` mints a fresh anonymous backend without touching
#     a stream. A plain string (`LET $p: PIPE = "ch"`) is a TypeMismatch
#     error.
#   - `$p` is the variable form in bindings and calls; there are no
#     named-pipe literals.
FUNC FILL($q: PIPE) {
    WITH_IO [stdout=$q] ECHO "filled"
    RETURN "filled-ok"
}

FUNC DRAIN($q: PIPE) {
    WITH_IO [stdin=$q] READ_LINE $line
    RETURN $line
}

# A function can also hand a pipe back: the caller receives a live handle.
FUNC MAKEPIPE($name: STRING) {
    LET $made: PIPE
    WITH_IO [stdout=$made] ECHO "seed"
    RETURN $made
}

LET $p: PIPE
WITH_IO [stdout=$p] ECHO "primed"
WITH_IO [stdin=$p] READ_LINE $primed
LET $fr: STRING = FILL($p)
LET $got: STRING = DRAIN($p)
WRITE got.txt "{{ $primed }}-{{ $fr }}-{{ $got }}"

LET $q: PIPE = MAKEPIPE("ignored")
LET $back: STRING = DRAIN($q)
WRITE back.txt "{{ $back }}"
