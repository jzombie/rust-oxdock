FUNC FILL($q: PIPE) {
    WITH_IO [stdout=$q] ECHO "filled"
    RETURN "filled-ok"
}

FUNC DRAIN($q: PIPE) {
    WITH_IO [stdin=$q] READ_LINE $line
    RETURN $line
}

FUNC MAKEPIPE($name: STRING) {
    WITH_IO [stdout=pipe:made] ECHO "seed"
    LET $p: PIPE = "made"
    RETURN $p
}

# A pipe handle travels into functions as a typed argument and is usable
# as a binding target in both directions.
WITH_IO [stdout=pipe:ch] ECHO "primed"
LET $p: PIPE = "ch"
WITH_IO [stdin=pipe:ch] READ_LINE $primed
LET $fr: STRING = CALL FILL($p)
LET $got: STRING = CALL DRAIN($p)
WRITE got.txt "{{ $primed }}-{{ $fr }}-{{ $got }}"

# And conversely a function can hand a pipe back to its caller.
LET $q: PIPE = CALL MAKEPIPE("ignored")
LET $back: STRING = CALL DRAIN($q)
WRITE back.txt "{{ $back }}"
