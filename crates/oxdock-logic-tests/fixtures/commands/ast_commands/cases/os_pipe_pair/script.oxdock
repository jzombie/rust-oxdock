# Concurrent kernel pipe pair: the ASYNC RUN producer promotes $live
# to an OS pipe (single RUN body), and the foreground WRITE drains it
# through a bridged reader. Under Miri the same script falls back to a
# script pipe with identical results.
LET $live: PIPE
WITH_IO [stdout=$live] ASYNC RUN "echo live-bytes"
WITH_IO [stdin=$live] WRITE live.txt
