{
  "targets": [
    {
      "name": "oxdock-parser-readme",
      "out": "crates/oxdock-parser/README.md",
      "values": "crates/oxdock-parser/.oxdock/template/values.json",
      "template": "crates/oxdock-parser/.oxdock/template/README.md.tmpl",
      "fragments": {
        "local": [
          "crates/oxdock-parser/.oxdock/template/fragments/*"
        ],
        "shared": [
          ".oxdock/template/shared/header.md.tmpl",
          ".oxdock/template/shared/footer.md.tmpl"
        ]
      }
    },
    {
      "name": "parser-rustdoc",
      "out": "crates/oxdock-parser/docs/command_reference.md",
      "values": "crates/oxdock-parser/.oxdock/template/values.json",
      "template": "crates/oxdock-parser/.oxdock/template/command_reference.md.tmpl",
      "fragments": {
        "generated": [
          ".oxdock/template/readme/generated/*"
        ]
      }
    }
  ]
}
