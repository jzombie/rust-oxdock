# Lifecycle caller: six phases, stubs only.
# The order lives in exactly one place: the STAGES list below. The
# composer reads it through STAGES() and unrolls the same order into
# the child, so there is nothing to drift.
IMPORT [STD]
IMPORT [TYPE CTX FROM "types.oxfile"]

FUNC STAGES() {
    RETURN ["INGEST", "ASSEMBLE", "RENDER", "DEFERRED", "WRITE_OUT", "VERIFY"]
}

FUNC INGEST($ctx: CTX) {
    RETURN $ctx
}

FUNC ASSEMBLE($ctx: CTX) {
    RETURN $ctx
}

FUNC RENDER($ctx: CTX) {
    RETURN $ctx
}

FUNC DEFERRED($ctx: CTX) {
    RETURN $ctx
}

FUNC WRITE_OUT($ctx: CTX) {
    RETURN $ctx
}

FUNC VERIFY($ctx: CTX) {
    RETURN $ctx
}

FUNC RUN_LIFECYCLE($ctx: CTX) {
    $ctx = INGEST($ctx)
    $ctx = ASSEMBLE($ctx)
    $ctx = RENDER($ctx)
    $ctx = DEFERRED($ctx)
    $ctx = WRITE_OUT($ctx)
    $ctx = VERIFY($ctx)
    RETURN $ctx
}

EXPORT INGEST
EXPORT ASSEMBLE
EXPORT RENDER
EXPORT DEFERRED
EXPORT WRITE_OUT
EXPORT VERIFY
EXPORT RUN_LIFECYCLE
EXPORT STAGES
