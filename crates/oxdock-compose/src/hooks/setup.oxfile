# SETUP hook: run-once intake. Generic passthrough: ensures the
# staging directory exists and returns context unchanged. Any
# domain enrichment (member sync, generated inputs, workspace
# snapshots) ships as that domain's own hook file instead and is
# registered under SETUP in that pipeline's config.
IMPORT [STD]
IMPORT [TYPE CTX FROM "../types.oxfile"]

FUNC SETUP($ctx: CTX) {
    RETURN $ctx
}

EXPORT SETUP
