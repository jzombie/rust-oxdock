# Lifecycle composer: composition all the way down.
#
# The parent assembles the lifecycle module in memory (pipe, no file
# written) or on disk (for tests asserting exact bytes) and the child
# is what executes the hooks. The engine stays agnostic: it only
# knows lifecycle method names (PRE_RENDER, ...) and calls them on
# the assembled module. Plugins register themselves by contributing
# hook-call lines inside the stage FUNC below.
#
# Two-phase expansion (the composition primitive): parent-side values
# (plugin paths, invented aliases, stage names, the context shape)
# bake in unescaped at compose time via {{ }}. Bare $ctx passes
# through literally: bare $ is never an interpolation trigger, only
# {{ }} is, so child-side bindings need no escaping.
IMPORT [STD]

# Compose one lifecycle stage as a module file.
#
# $plugins is a LIST of plugin entries, each a MAP with path, alias,
# and the LIST<STRING> of lifecycle names that plugin handles. Only
# hooks equal to $stage land inside the emitted FUNC; registration
# order is call order. $ctx_type is the exact context shape baked
# into the emitted FUNC signature (one shape per pipeline, never an
# open map). Accumulates the per-plugin lines into multiline
# variables, then a single WRITE lands the module atomically instead
# of leaving a partial file if a mid-loop step fails.
FUNC COMPOSE_STAGE($plugins: LIST<MAP<path: STRING, alias: STRING, hooks: LIST<STRING>>>, $stage: STRING, $ctx_type: STRING, $out: STRING) {
    LET $imports: STRING = ""
    FOR $p: MAP<path: STRING, alias: STRING, hooks: LIST<STRING>> IN $plugins {
        $imports = "{{ $imports }}IMPORT [\"{{ $p.path }}\" AS {{ $p.alias }}]\n"
    }
    LET $calls: STRING = ""
    FOR $p: MAP<path: STRING, alias: STRING, hooks: LIST<STRING>> IN $plugins {
        FOR $h: STRING IN $p.hooks {
            IF $h == $stage {
                $calls = "{{ $calls }}    $ctx = {{ $p.alias }}::{{ $h }}($ctx)\n"
            }
        }
    }
    LET $mod: STRING = """
IMPORT [STD]
{{ $imports }}FUNC {{ $stage }}($ctx: {{ $ctx_type }}) {
{{ $calls }}    RETURN $ctx
}
EXPORT {{ $stage }}
"""
    WRITE $out "{{ $mod }}\n"
}

EXPORT COMPOSE_STAGE
