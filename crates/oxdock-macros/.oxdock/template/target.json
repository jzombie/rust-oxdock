{
  "targets": [
    {
      "name": "oxdock-macros-readme",
      "out": "oxdock-macros/README.md",
      "values": "oxdock-macros/.oxdock/template/values.json",
      "template": "oxdock-macros/.oxdock/template/README.md.tmpl",
      "fragments": {
        "local": [
          "oxdock-macros/.oxdock/template/fragments/*"
        ],
        "shared": [
          ".oxdock/template/shared/header.md.tmpl",
          ".oxdock/template/shared/footer.md.tmpl"
        ]
      }
    }
  ]
}
