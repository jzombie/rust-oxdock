{
  "targets": [
    {
      "name": "oxdock-pipe-readme",
      "out": "crates/sys/oxdock-pipe/README.md",
      "values": "crates/sys/oxdock-pipe/.oxdock/template/values.json",
      "template": "crates/sys/oxdock-pipe/.oxdock/template/README.md.tmpl",
      "fragments": {
