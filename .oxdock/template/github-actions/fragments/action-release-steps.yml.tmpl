    - name: {{ $ctx.install_label }}
      if: $\{{ inputs.source != 'local' && runner.os != 'Windows' }}
      shell: bash
      env:
        VERSION: $\{{ inputs.version }}
        INSTALL_DIR: $\{{ runner.temp }}/{{ $ctx.install_dir }}
        OXDOCK_PRODUCT: {{ $ctx.product }}
        OXDOCK_BINARY_NAME: $\{{ inputs.binary-name }}
        GITHUB_TOKEN: $\{{ github.token }}
      run: |
        curl -fsSL ${GITHUB_TOKEN:+-H "Authorization: Bearer $GITHUB_TOKEN"} {{ $global.stub_url_sh }} | bash

    - name: {{ $ctx.install_label }}
      if: $\{{ inputs.source != 'local' && runner.os == 'Windows' }}
      shell: pwsh
      env:
        VERSION: $\{{ inputs.version }}
        INSTALL_DIR: $\{{ runner.temp }}/{{ $ctx.install_dir }}
        OXDOCK_PRODUCT: {{ $ctx.product }}
        OXDOCK_BINARY_NAME: $\{{ inputs.binary-name }}
        GITHUB_TOKEN: $\{{ github.token }}
      run: |
        $h = @{}; if ($env:GITHUB_TOKEN) { $h.Authorization = "Bearer $env:GITHUB_TOKEN" }; (irm '{{ $global.stub_url_ps1 }}' -Headers $h) | iex

