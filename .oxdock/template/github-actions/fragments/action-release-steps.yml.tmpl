    - name: {{ $ctx.install_label }}
      if: $\{{ inputs.source != 'local' && runner.os != 'Windows' }}
      shell: bash
      env:
        VERSION: $\{{ inputs.version }}
        INSTALL_DIR: $\{{ runner.temp }}/{{ $ctx.install_dir }}
        OXDOCK_PRODUCT: {{ $ctx.product }}
        OXDOCK_BINARY_NAME: $\{{ inputs.binary-name }}
      run: {{ $global.installer_cmd_sh }}

    - name: {{ $ctx.install_label }}
      if: $\{{ inputs.source != 'local' && runner.os == 'Windows' }}
      shell: pwsh
      env:
        VERSION: $\{{ inputs.version }}
        INSTALL_DIR: $\{{ runner.temp }}/{{ $ctx.install_dir }}
        OXDOCK_PRODUCT: {{ $ctx.product }}
        OXDOCK_BINARY_NAME: $\{{ inputs.binary-name }}
      run: {{ $global.installer_cmd_ps1 }}

