{{ $files.local.action-header }}

{{ $files.local.action-inputs }}

runs:
  using: composite
  steps:
{{ $files.local.action-release-steps }}
{{ $files.local.install-rust }}
    - name: Build local OxDock renderer
      if: $\{{ inputs.source == 'local' }}
      shell: pwsh
      working-directory: $\{{ github.workspace }}
      env:
        OXDOCK_BIN: $\{{ github.workspace }}/target/release/oxdock-render$\{{ runner.os == 'Windows' && '.exe' || '' }}
        OXDOCK_ENGINE_BIN: $\{{ github.workspace }}/target/release/oxdock$\{{ runner.os == 'Windows' && '.exe' || '' }}
        OXDOCK_OXFILE: $\{{ github.workspace }}/install.oxfile
        OXDOCK_PRODUCT: oxdock-render
        OXDOCK_DIR: $\{{ runner.temp }}/oxdock-render
        OXDOCK_VERSION: local
        OXDOCK_BINARY_NAME: $\{{ inputs.binary-name }}
        OXDOCK_SKIP_DOWNLOAD: '1'
      run: |
        $ErrorActionPreference='Stop'
        cargo build --release -p oxdock -p oxdock-render --bins --all-features
        # The renderer cannot interpret the installer logic itself: the
        # freshly built engine runs the same file, which places the whole
        # product (renderer plus sidecars like oxdock-render-child).
        # Bridge the product member inventory from the release dir so the
        # installer places every renderer binary by name.
        $sibDir = (Split-Path $env:OXDOCK_BIN -Parent)
        $primaryLeaf = (Split-Path $env:OXDOCK_BIN -Leaf)
        $env:OXDOCK_SIBLING_DIR = $sibDir
        $env:OXDOCK_MEMBERS = ((Get-ChildItem (Join-Path $sibDir 'oxdock-render*') -File | Where-Object { $_.Extension -notin @('.d', '.pdb') } | Select-Object -ExpandProperty Name) -join "`n")
        $env:OXDOCK_PRIMARY = $primaryLeaf
        & $env:OXDOCK_ENGINE_BIN $env:OXDOCK_OXFILE
