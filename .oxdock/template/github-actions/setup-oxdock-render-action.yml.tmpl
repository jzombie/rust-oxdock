# Setup OxDock renderer for `oxdock-render` steps.
#
# Single installer: `release` runs the stub. Inputs cross on `env:`,
# every decision lives in the stub + `install.oxfile`. `local` builds
# with cargo, then reuses the same file. Stubs are fetched, never
# vendored.
#
# GENERATED by docs-gen from `.oxdock/template/github-actions/`: do not
# edit by hand. The `run:` one-liners below render from the shared
# `installer_cmd_sh` / `installer_cmd_ps1` globals.
name: Setup OxDock renderer
description: Install the oxdock-render binary so later steps can render docs.

inputs:
  version:
    description: Full release tag to install (e.g. v0.37.0-alpha), or `latest` to resolve the newest release. Ignored when source is `local`.
    required: false
    default: latest
  binary-name:
    description: Installed executable stem (`oxdock-render` keeps the bare name free for a binary under test only when overridden).
    required: false
    default: oxdock-render
  source:
    description: Renderer provenance (`release` downloads the installer for `version`; `local` builds the caller's checkout with cargo, so unreleased renderer behavior is testable before any tag exists). An empty value behaves as `release`, so callers may pass the OXDOCK_RENDER_SOURCE workflow variable and select the provenance once in workflow `env:`; deleting that variable restores the release without touching any call site.
    required: false
    default: release

runs:
  using: composite
  steps:
    - name: Install OxDock renderer
      if: $\{{ inputs.source != 'local' && runner.os != 'Windows' }}
      shell: bash
      env:
        VERSION: $\{{ inputs.version }}
        INSTALL_DIR: $\{{ runner.temp }}/oxdock-render
        OXDOCK_PRODUCT: oxdock-render
        OXDOCK_BINARY_NAME: $\{{ inputs.binary-name }}
      run: {{ $docs_global.installer_cmd_sh }}

    - name: Install OxDock renderer
      if: $\{{ inputs.source != 'local' && runner.os == 'Windows' }}
      shell: pwsh
      env:
        VERSION: $\{{ inputs.version }}
        INSTALL_DIR: $\{{ runner.temp }}/oxdock-render
        OXDOCK_PRODUCT: oxdock-render
        OXDOCK_BINARY_NAME: $\{{ inputs.binary-name }}
      run: {{ $docs_global.installer_cmd_ps1 }}

    - name: Install Rust
      if: $\{{ inputs.source == 'local' }}
      uses: dtolnay/rust-toolchain@stable

    - name: Build local OxDock renderer
      if: $\{{ inputs.source == 'local' }}
      shell: pwsh
      working-directory: $\{{ github.workspace }}
      env:
        OXDOCK_BIN: $\{{ github.workspace }}/target/release/oxdock-render$\{{ runner.os == 'Windows' && '.exe' || '' }}
        OXDOCK_ENGINE_BIN: $\{{ github.workspace }}/target/release/oxdock$\{{ runner.os == 'Windows' && '.exe' || '' }}
        OXDOCK_OXFILE: $\{{ github.workspace }}/install.oxfile
        OXDOCK_PRODUCT: oxdock-render
        OXDOCK_DIR: $\{{ runner.temp }}/oxdock-render
        OXDOCK_VERSION: local
        OXDOCK_BINARY_NAME: $\{{ inputs.binary-name }}
        OXDOCK_SKIP_DOWNLOAD: '1'
      run: |
        $ErrorActionPreference='Stop'
        cargo build --release -p oxdock -p oxdock-render --bins --all-features
        # The renderer cannot interpret the installer logic itself: the
        # freshly built engine runs the same file, which places the whole
        # product (renderer plus sidecars like oxdock-render-child).
        # Bridge the product member inventory from the release dir so the
        # installer places every renderer binary by name.
        $sibDir = (Split-Path $env:OXDOCK_BIN -Parent)
        $primaryLeaf = (Split-Path $env:OXDOCK_BIN -Leaf)
        $env:OXDOCK_SIBLING_DIR = $sibDir
        $env:OXDOCK_MEMBERS = ((Get-ChildItem (Join-Path $sibDir 'oxdock-render*') -File | Where-Object { $_.Extension -notin @('.d', '.pdb') } | Select-Object -ExpandProperty Name) -join "`n")
        $env:OXDOCK_PRIMARY = $primaryLeaf
        & $env:OXDOCK_ENGINE_BIN $env:OXDOCK_OXFILE
