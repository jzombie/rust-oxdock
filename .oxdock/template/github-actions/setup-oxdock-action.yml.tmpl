{{ $files.local.action-header }}

{{ $files.local.action-inputs }}

runs:
  using: composite
  steps:
    - name: Validate engine source input
      if: $\{{ inputs.source != '' && inputs.source != 'release' && inputs.source != 'local' }}
      shell: bash
      env:
        OXDOCK_SOURCE: $\{{ inputs.source }}
      run: |
        echo "Invalid source '$OXDOCK_SOURCE': must be '', 'release', or 'local'" >&2
        exit 1
{{ $files.local.action-release-steps }}
{{ $files.local.install-rust }}
    - name: Build local OxDock engine
      if: $\{{ inputs.source == 'local' && runner.os != 'Windows' }}
      shell: bash
      working-directory: $\{{ github.workspace }}
      env:
        OXDOCK_BINARY_NAME: $\{{ inputs.binary-name }}
      run: |
        set -euo pipefail
        TARGET_DIR="${CARGO_TARGET_DIR:-target}"
        cargo build --release -p oxdock
        INSTALL_DIR="$\{{ runner.temp }}/oxdock-engine"
        mkdir -p "$INSTALL_DIR"
        BINARY_NAME="${OXDOCK_BINARY_NAME:-oxdock}"
        cp "$TARGET_DIR/release/oxdock" "$INSTALL_DIR/$BINARY_NAME"
        echo "$INSTALL_DIR" >> "$GITHUB_PATH"
    - name: Build local OxDock engine
      if: $\{{ inputs.source == 'local' && runner.os == 'Windows' }}
      shell: pwsh
      working-directory: $\{{ github.workspace }}
      env:
        OXDOCK_BINARY_NAME: $\{{ inputs.binary-name }}
      run: |
        $ErrorActionPreference='Stop'
        $targetDir = if ($env:CARGO_TARGET_DIR) { $env:CARGO_TARGET_DIR } else { 'target' }
        cargo build --release -p oxdock
        $installDir = "$env:RUNNER_TEMP/oxdock-engine"
        New-Item -ItemType Directory -Force -Path $installDir | Out-Null
        $binaryName = if ($env:OXDOCK_BINARY_NAME) { $env:OXDOCK_BINARY_NAME } else { 'oxdock' }
        Copy-Item (Join-Path $targetDir 'release/oxdock.exe') (Join-Path $installDir "$binaryName.exe")
        Add-Content -Path $env:GITHUB_PATH -Value $installDir
