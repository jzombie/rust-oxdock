# Installs the downloaded OxDock release binary.
# Piped stdin runs instead of installing.

IMPORT [STD]

INHERIT_ENV [OXDOCK_ASSET, OXDOCK_SHA, OXDOCK_BIN, OXDOCK_DIR, OXDOCK_VERSION, OXDOCK_PIPED_SCRIPT, OXDOCK_INTERPRETER, OXDOCK_INTERACTIVE, OXDOCK_BINARY_NAME, OXDOCK_EXPECTED_VERSION, GITHUB_PATH, GITHUB_ENV, OXDOCK_SKIP_DOWNLOAD]

WORKSPACE SYSTEM

# Piped input runs under the fetched interpreter.
LET $piped: STRING = "\{{ env:OXDOCK_PIPED_SCRIPT }}"
LET $has_piped: BOOL = $piped != ""

IF $has_piped {
    RUN ["\{{ env:OXDOCK_INTERPRETER }}", "\{{ env:OXDOCK_PIPED_SCRIPT }}"]
} ELSE {
    LET $asset: STRING = "\{{ env:OXDOCK_ASSET }}"
    LET $want: STRING = "\{{ env:OXDOCK_SHA }}"
    LET $bin: STRING = "\{{ env:OXDOCK_BIN }}"
    LET $dir: STRING = "\{{ env:OXDOCK_DIR }}"

    # Install name, default `oxdock`. The stub passes the stem through
    # untouched; the single strip lives here.
    LET $rawstem: STRING = "\{{ env:OXDOCK_BINARY_NAME }}"
    LET $stem: STRING = TEXT_TRIM_SUFFIX($rawstem, ".exe")
    LET $missing_stem: BOOL = $stem == ""

    IF $missing_stem {
        $stem = "oxdock"
    }

    # Skip flag for `local` builds.
    LET $skip: BOOL = "\{{ env:OXDOCK_SKIP_DOWNLOAD }}"

    # Interactive destination prompt.
    IF "\{{ env:OXDOCK_INTERACTIVE }}" != "" {
        PROMPT $dir "Install destination?" "\{{ env:OXDOCK_DIR }}"

        WHILE true {
            LET $kind: STRING = PATH_TYPE($dir)
            LET $writable: BOOL = PATH_WRITABLE($dir)

            IF $kind == "dir" || $kind == "absent" {
                IF $writable {
                    BREAK
                }
            }

            PROMPT $dir "Install destination?"
        }
    }

    # Missing dir fails naming the override.
    IF $dir == "" {
        [family:unix] LET $home: STRING = "\{{ env:HOME }}"
        [family:windows] LET $home: STRING = "\{{ env:USERPROFILE }}"

        IF $home == "" {
            [family:unix] ECHO "no install directory: HOME is unset, so set INSTALL_DIR (example: INSTALL_DIR=\"$HOME/{{ $docs_global.unix_default_suffix }}\")"
            [family:windows] ECHO "no install directory: USERPROFILE is unset, so set INSTALL_DIR (example: $env:INSTALL_DIR = \"{{ $docs_global.windows_default_prefix }}{{ $docs_global.windows_default_suffix }}\")"
            EXIT 1
        }

        [family:unix] ECHO "no install directory: set INSTALL_DIR (example: INSTALL_DIR=\"$HOME/{{ $docs_global.unix_default_suffix }}\")"
        [family:windows] ECHO "no install directory: set INSTALL_DIR (example: $env:INSTALL_DIR = \"{{ $docs_global.windows_default_prefix }}{{ $docs_global.windows_default_suffix }}\")"
        EXIT 1
    }

    # Destination derives after the prompt: PROMPT mutates $dir in
    # place, and placing before it would strand the binary at the
    # pre-prompt default while reporting the prompted dir.
    LET $filename: STRING = "\{{ $stem }}"
    [family:windows] $filename = "\{{ $stem }}.exe"
    LET $dest: STRING = PATH_JOIN($dir, $filename)

    # Verify and place. The CI tail runs only on the fresh pass
    # below, never here: the old engine must not touch CI files.
    IF $skip {
        LET $has_bin: BOOL = $bin != ""

        IF $has_bin {
            INSTALL $bin $dest
        }

        ECHO "installed oxdock \{{ env:OXDOCK_VERSION }} to \{{ $dir }}"
        ECHO "ensure \{{ $dir }} is on PATH"

        # CI smoke and PATH publish, fresh engine only. Strict nest:
        # assert + APPENDs together or not at all.
        LET $ghpath: STRING = "\{{ env:GITHUB_PATH }}"
        LET $has_ghpath: BOOL = $ghpath != ""

        IF $has_ghpath {
            LET $ghkind: STRING = PATH_TYPE($ghpath)
            LET $is_ghfile: BOOL = $ghkind == "file"

            IF $is_ghfile {
                # Expected version, one rule: a `v`-tagged bridge wins
                # (real tags gate hard); anything else derives from the
                # placed binary itself. Legs ride fictitious versions,
                # so only real tags assert.
                LET $bridge: STRING = "\{{ env:OXDOCK_EXPECTED_VERSION }}"
                LET $use_bridge: BOOL = TEXT_STARTS_WITH($bridge, "v")
                LET $expected: STRING = ""

                IF $use_bridge {
                    $expected = TEXT_TRIM_PREFIX($bridge, "v")
                } ELSE {
                    LET $bv: PIPE
                    WITH_IO [stdout=$bv] RUN ["\{{ $dest }}", "--version"]
                    WITH_IO [stdin=$bv] READ_LINE $rawver
                    $expected = TEXT_TRIM_PREFIX($rawver, "oxdock ")
                }

                LET $has_expected: BOOL = $expected != ""

                IF $has_expected {
                    LET $tailkind: STRING = PATH_TYPE("\{{ $dest }}")
                    ASSERT_EQ $tailkind "file"

                    LET $v: PIPE
                    WITH_IO [stdout=$v] RUN ["\{{ $dest }}", "--version"]
                    WITH_IO [stdin=$v] READ_LINE $reported
                    ASSERT_EQ $reported "oxdock \{{ $expected }}"

                    APPEND "\{{ env:GITHUB_PATH }}" "\{{ $dir }}\n"

                    LET $ghenv: STRING = "\{{ env:GITHUB_ENV }}"
                    LET $has_ghenv: BOOL = $ghenv != ""

                    IF $has_ghenv {
                        LET $envkind: STRING = PATH_TYPE($ghenv)
                        LET $is_envfile: BOOL = $envkind == "file"

                        IF $is_envfile {
                            APPEND "\{{ env:GITHUB_ENV }}" "OXDOCK_ENGINE_DIR=\{{ $dir }}\n"
                        }
                    }
                }
            }
        }
    } ELSE {
        LET $actual: STRING = HASH_SHA256 $asset
        ASSERT_EQ $actual "\{{ $want }}\n"

        INSTALL $bin $dest

        ECHO "installed oxdock \{{ env:OXDOCK_VERSION }} to \{{ $dir }}"
        ECHO "ensure \{{ $dir }} is on PATH"
    }
}
