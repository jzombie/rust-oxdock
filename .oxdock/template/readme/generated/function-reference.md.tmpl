IMPORT [STD]
LET $swapped: STRING = TEXT_REPLACE_REGEX("2026-10-13", "(\\d+)-(\\d+)-(\\d+)", "$3/$2/$1")
ASSERT_EQ $swapped "13/10/2026"
```

**Example: replace regex pipe mirrors**

```oxdock
