**Example: unseeded draw**

```oxdock
# Scale a unit draw into a backoff delay between 1 and 11 seconds.
IMPORT [STD]
LET $draw: FLOAT = RAND()
LET $delay: FLOAT = 1.0 + $draw * 10.0
IF $delay < 1.0 {
    EXIT 1
}
IF $delay >= 11.0 {
    EXIT 1
}
ECHO "retrying in \{{ $delay }}s"
```

