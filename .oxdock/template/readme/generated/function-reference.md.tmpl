WITH_IO [stdout=$cap] {
    ECHO "2026-10-13"
}
LET $trimmed: PIPE = TEXT_TRIM($cap)
LET $out: PIPE = TEXT_REPLACE_REGEX($trimmed, "(\\d+)-(\\d+)-(\\d+)", "$3/$2/$1")
WITH_IO [stdin=$out] READ_LINE $line
ASSERT_EQ $line "13/10/2026"
```

**Example: replace regex template**

```oxdock
