{
  "targets": [
    {
      "name": "readme",
      "out": "README.md",
      "values": ".oxdock/template/readme/values.json",
      "template": ".oxdock/template/readme/README.md.tmpl",
      "fragments": {
        "local": [
          ".oxdock/template/readme/fragments/*"
        ],
        "shared": [
          ".oxdock/template/shared/*"
        ],
        "generated": [
          ".oxdock/template/readme/generated/*"
        ]
      }
    },
    {
      "name": "citation-cff",
      "out": "CITATION.cff",
      "values": ".oxdock/template/readme/values.json",
      "template": ".oxdock/template/readme/CITATION.cff.tmpl",
      "fragments": {}
    },
    {
      "name": "install-sh",
      "out": "bootstrap.sh",
      "values": ".oxdock/template/readme/values.json",
      "template": ".oxdock/template/readme/bootstrap.sh.tmpl",
      "fragments": {
        "stubs": [
          ".oxdock/template/readme/stubs/*"
        ]
      }
    },
    {
      "name": "install-ps1",
      "out": "bootstrap.ps1",
      "values": ".oxdock/template/readme/values.json",
      "template": ".oxdock/template/readme/bootstrap.ps1.tmpl",
      "fragments": {
        "stubs": [
          ".oxdock/template/readme/stubs/*"
        ]
      }
    }
  ]
}
