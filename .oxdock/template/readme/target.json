{
  "targets": [
    {
      "name": "readme",
      "out": "README.md",
      "values": ".oxdock/template/readme/values.json",
      "template": ".oxdock/template/readme/README.md.tmpl",
      "fragments": {
        "local": [
          ".oxdock/template/readme/fragments/*"
        ],
        "shared": [
          ".oxdock/template/shared/*"
        ],
        "generated": [
          ".oxdock/template/readme/generated/*"
        ],
        "commands": [
          ".oxdock/template/cli/fragments/run-install-sh.md.tmpl",
          ".oxdock/template/cli/fragments/run-install-ps1.md.tmpl"
        ]
      }
    },
    {
      "name": "citation-cff",
      "out": "CITATION.cff",
      "values": ".oxdock/template/readme/values.json",
      "template": ".oxdock/template/readme/CITATION.cff.tmpl",
      "fragments": {}
    },
    {
      "name": "install-sh",
      "out": "install.sh",
      "values": ".oxdock/template/readme/values.json",
      "template": ".oxdock/template/readme/install.sh.tmpl",
      "executable": true,
      "fragments": {
        "stubs": [
          ".oxdock/template/readme/stubs/*"
        ],
        "commands": [
          ".oxdock/template/cli/fragments/run-install-sh.md.tmpl"
        ]
      }
    },
    {
      "name": "install-ps1",
      "out": "install.ps1",
      "values": ".oxdock/template/readme/values.json",
      "template": ".oxdock/template/readme/install.ps1.tmpl",
      "fragments": {
        "stubs": [
          ".oxdock/template/readme/stubs/*"
        ],
        "commands": [
          ".oxdock/template/cli/fragments/run-install-ps1.md.tmpl"
        ]
      }
    },
    {
      "name": "install-sh-action",
      "out": ".github/actions/setup-oxdock/install.sh",
      "values": ".oxdock/template/readme/values.json",
      "template": ".oxdock/template/readme/install.sh.tmpl",
      "executable": true,
      "fragments": {
        "stubs": [
          ".oxdock/template/readme/stubs/*"
        ],
        "commands": [
          ".oxdock/template/cli/fragments/run-install-sh.md.tmpl"
        ]
      }
    },
    {
      "name": "install-ps1-action",
      "out": ".github/actions/setup-oxdock/install.ps1",
      "values": ".oxdock/template/readme/values.json",
      "template": ".oxdock/template/readme/install.ps1.tmpl",
      "fragments": {
        "stubs": [
          ".oxdock/template/readme/stubs/*"
        ],
        "commands": [
          ".oxdock/template/cli/fragments/run-install-ps1.md.tmpl"
        ]
      }
    }
  ]
}
