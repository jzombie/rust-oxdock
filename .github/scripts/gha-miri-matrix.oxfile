# Miri shard enumeration: the full `cargo miri test --lib --tests`
# workspace run takes 6h+ (run 41846432872 timed out), so this script
# splits it into matrix shards that each run a disjoint slice.
#
# Two levels, both dynamic (no hardcoded crates, targets, or tests):
# 1. One pair per lib + per integration test binary, in workspace
#    order (see MIRI_JOBS below). Bins carry no tests and doctests
#    don't run under Miri, so libs + integration targets are the
#    whole provable set.
# 2. Shards: each pair's `cargo test --list` output is dealt into
#    slices of at most $shard_size tests. One matrix entry per slice:
#    {package, args, tests, index} where `tests` is the space-separated
#    `--exact` filter list the shard runs. Repeated matrix titles
#    (same package + args, different index) are slices of one pair,
#    not duplicate pairs.
#
# Invoked from the miri-nightly workflow (enumerate job) only. Writes
# `matrix` (JSON array of shards) and `cache_key` to GITHUB_OUTPUT
# for the matrix and cache steps downstream.

INHERIT_ENV [GITHUB_OUTPUT, GITHUB_WORKSPACE, RUSTFLAGS]

IMPORT [STD, "helpers/ci-helpers.oxfile" AS CI_HELPERS]

# Unconfined: this script only writes outside the checkout
# (GITHUB_OUTPUT) and shells out for the rest. WORKSPACE LOCAL would
# rebase the absolute GITHUB_OUTPUT path back under the repo, and the
# matrix would never reach downstream jobs.
WORKSPACE SYSTEM
WORKDIR "{{ env:GITHUB_WORKSPACE }}"
ENV CARGO_TARGET_DIR="{{ env:GITHUB_WORKSPACE }}/target"

# List every test binary in the workspace: one pair per lib and per
# integration test target, in workspace order, e.g.
# ["oxdock-core", "--lib"]. Bins carry no tests (only `main`,
# which Miri would interpret with nothing to assert); doctests are
# unsupported under Miri upstream. Libs + integration targets are
# the whole provable set. The chunk loop below splits each pair's
# tests into shards of at most $shard_size tests.
FUNC MIRI_JOBS($packages: LIST<MAP<ANY>>) {
  LET $jobs: LIST<LIST<STRING>> = []
  FOR $p: MAP<ANY> IN $packages {
    LET $pkg: STRING = $p.name
    LET $targets: LIST<MAP<ANY>> = $p.targets
    LET $has_lib: BOOL = false
    LET $bins: LIST<STRING> = []
    FOR $t: MAP<ANY> IN $targets {
      LET $kinds: LIST<STRING> = $t.kind
      LET $tname: STRING = $t.name
      FOR $k: STRING IN $kinds {
        IF $k == "lib" {
          $has_lib = true
        }
        IF $k == "test" {
          LIST_APPEND $bins $tname
        }
      }
    }
    IF $has_lib {
      LET $job: LIST<STRING> = [$pkg, "--lib"]
      LIST_APPEND $jobs $job
    }
    FOR $b: STRING IN $bins {
      LET $job: LIST<STRING> = [$pkg, "--test {{ $b }}"]
      LIST_APPEND $jobs $job
    }
  }
  RETURN $jobs
}

# One matrix entry: {package, args, tests, index} as JSON. Single
# construction site for the chunk loop below, which flushes on full
# shards and once more on the remainder.
FUNC MIRI_SHARD_ENTRY($pkg: STRING, $flag: STRING, $tests: STRING, $index: INT) {
  RETURN "{\"package\":\"{{ $pkg }}\",\"args\":\"{{ $flag }}\",\"tests\":\"{{ $tests }}\",\"index\":{{ $index }}}"
}

# Shard cap: tests per matrix entry. Sized so the slowest shard stays
# far under the 6h job limit; wall-time scales linearly with this
# number, so raise it only if the heaviest suite stays well clear.
LET $shard_size: INT = 50

# Cache key inputs, same recipe as the build jobs (no sha256sum).
LET $lock: STRING = CI_HELPERS::LOCKFILE_HASH()
LET $report: STRING = RUN ["rustc", "-Vv"]
LET $rustc: STRING = CI_HELPERS::RUSTC_HASH($report)

# Workspace members and their test targets, no hardcoding: one pair
# per lib + per integration test binary (see MIRI_JOBS above). The
# loop below chunks each pair into shards of at most $shard_size
# tests.
LET $packages: LIST<MAP<ANY>> = CI_HELPERS::WORKSPACE_PACKAGES()
LET $jobs: LIST<LIST<STRING>> = MIRI_JOBS($packages)

# Chunk each pair's test list into shards: names feed `--exact`
# filters at run time, so shards partition the target's tests with
# no overlap. Each flush below emits one matrix entry; the trailing
# flush emits the remainder.
LET $entries: LIST<STRING> = []
LET $index: INT = 0
FOR $j: LIST<STRING> IN $jobs {
    LET $pkg: STRING = $j.0
    LET $flag: STRING = $j.1
    LET $listing: STRING = RUN "cargo test -p {{ $pkg }} --all-features {{ $flag }} -- --list --format terse || true"
    LET $lines: LIST<STRING> = TEXT_LINES($listing)
    LET $cur: STRING = ""
    LET $n: INT = 0
    FOR $line: STRING IN $lines {
        IF TEXT_CONTAINS($line, ": test") {
            LET $name: STRING = TEXT_TRIM_SUFFIX($line, ": test")
            IF $cur == "" {
                $cur = $name
            } ELSE {
                $cur = "{{ $cur }} {{ $name }}"
            }
            $n = $n + 1
            IF $n >= $shard_size {
                $index = $index + 1
                LET $entry: STRING = MIRI_SHARD_ENTRY($pkg, $flag, $cur, $index)
                LIST_APPEND $entries $entry
                $cur = ""
                $n = 0
            }
        }
    }
    IF $n > 0 {
        $index = $index + 1
        LET $entry: STRING = MIRI_SHARD_ENTRY($pkg, $flag, $cur, $index)
        LIST_APPEND $entries $entry
    }
}

LET $sep: STRING = ","
LET $matrix: STRING = "[{{ STD::TEXT_JOIN($entries, $sep) }}]"
ECHO "Miri shards: {{ $index }}"

LET $gh_out: STRING = "{{ env:GITHUB_OUTPUT }}"
APPEND_LINE $gh_out "matrix={{ $matrix }}"
APPEND_LINE $gh_out "cache_key=miri-ubuntu-latest-{{ $rustc }}-{{ $lock }}"
