// Shared CI helpers: pure FUNCs used by inline `oxdock --script`
// legs and by the `gha-*.oxfile` file scripts across
// `.github/workflows`. Stays side-effect free on purpose:
// the import boundary reverts ENV/WORKDIR/WORKSPACE/LET, so each leg
// keeps its own sandbox header and calls in here only for repeated
// logic (hash extraction), binding RETURNs itself. Configuration
// rides the inherited environment (`env:GITHUB_WORKSPACE`),
// declared below: every file stands alone, so this module declares
// what its functions read. Module calls never inherit caller context:
// the declared name re-reads from the host on every call, and the
// workspace below reaches the checkout explicitly. Declares its own
// STD dependency: every file resolves its names against its own
// imports. Prelude order matters: INHERIT leads, IMPORT follows.
INHERIT_ENV [GITHUB_WORKSPACE]
IMPORT [STD]

# Lockfile hash for cache keys. Module calls never inherit caller
# context: the workspace resets to the run-initial root, so reach the
# checkout explicitly.
FUNC LOCKFILE_HASH(): STRING {
  WORKSPACE SYSTEM

  RETURN HASH_SHA256(PATH_JOIN(env:GITHUB_WORKSPACE, "Cargo.lock"))
}
EXPORT LOCKFILE_HASH

FUNC RUSTC_HASH($report: STRING): STRING {
  LET $caps: LIST<STRING> = TEXT_EXTRACT($report, "(?m)^commit-hash: (\\S+)")
  RETURN $caps.1
}
EXPORT RUSTC_HASH

# Workspace package version for gates and tags. Same workspace
# discipline as LOCKFILE_HASH above: reach the checkout explicitly so
# file scripts importing this module resolve the manifest from the
# checkout, not the module directory.
FUNC MANIFEST_VERSION(): STRING {
  WORKSPACE SYSTEM

  LET $manifest: MAP<ANY> = LOAD_TOML(PATH_JOIN(env:GITHUB_WORKSPACE, "Cargo.toml"))
  IF HAS_KEY($manifest, "workspace") {
    LET $ws: MAP<ANY> = $manifest.workspace
    IF HAS_KEY($ws, "package") {
      LET $v: STRING = $manifest.workspace.package.version
      RETURN $v
    } ELSE {
      LET $v: STRING = $manifest.package.version
      RETURN $v
    }
  } ELSE {
    LET $v: STRING = $manifest.package.version
    RETURN $v
  }
}
EXPORT MANIFEST_VERSION

# Raw `cargo metadata` package entries (name, version, targets) in
# workspace order. The shared primitive behind every script that
# walks the workspace: Miri shards, release publish rounds.
#
# Reach the checkout explicitly and unconfined: module calls never
# inherit the caller's WORKSPACE or WORKDIR, and cargo metadata must
# resolve the real checkout (under LOCAL the module directory falls
# outside the snapshot root).
FUNC WORKSPACE_PACKAGES(): LIST<MAP<ANY>> {
  WORKSPACE SYSTEM
  WORKDIR "{{ env:GITHUB_WORKSPACE }}"

  # Shell form, not argv: the recording test harness matches mock
  # responses by command substring, which only exists for shell runs.
  LET $meta_raw: STRING = RUN "cargo metadata --no-deps --format-version 1"
  LET $meta: MAP<ANY> = PARSE_JSON($meta_raw)
  LET $pkgs: LIST<MAP<ANY>> = $meta.packages
  RETURN $pkgs
}
EXPORT WORKSPACE_PACKAGES
