# Release pipeline for OxDock itself: version gate, workspace publish,
# tag, and GitHub release. Dispatch is manual only via the release
# workflow, which bridges CONFIRM_VERSION and DRY_RUN from its inputs.
# RELEASE_DRY_RUN is a BOOL flag: "false" publishes, anything else
# (including unset, which defaults true) dry-runs. CI always bridges
# inputs.dry_run explicitly; the unset case only fires on hand-runs,
# which stay dry-run by construction.
# The workflow builds this commit's binary and runs this commit's script,
# so language and script stay mutually consistent by construction.

INHERIT_ENV [GH_TOKEN, RELEASE_CONFIRM, RELEASE_DRY_RUN, RELEASE_BINS, RELEASE_BINARIES, GITHUB_ACTIONS, CARGO_REGISTRY_TOKEN, RUNNER_TEMP, GITHUB_WORKSPACE]
IMPORT [STD, MARKDOWN, "helpers/ci-helpers.oxfile" AS CI_HELPERS]

# Pin to the live tree: scripts start in an isolated snapshot, and every
# release step (manifest read, publish, tag) must hit the real repo.
WORKSPACE LOCAL

LET $version: STRING = CI_HELPERS::MANIFEST_VERSION()

# Typed confirmation gate: the dispatched version must equal the tree.
# A typo or stale input fails here, before anything publishes.
LET $confirm: STRING = "{{ env:RELEASE_CONFIRM }}"
ASSERT_EQ $confirm $version

# Release notes come from the CHANGELOG through the real markdown
# parser, sliced under target/ (gitignored) so the notes file itself
# never trips cargo's clean-tree publish guard.
LET $log: STRING = READ "CHANGELOG.md"
LET $notes: STRING = MARKDOWN::SECTION($log, "[{{ $version }}]")
WRITE "target/release-notes.md" $notes

# Date gate: the shipping heading must carry a real ` - YYYY-MM-DD`
# date (no TBD). The full gate (file-wide shape, ranges, calendar,
# monotonicity) lives in gha-rust-validate.oxfile, which blocks the
# matrix; this re-checks the heading being shipped so a bypassed or
# hand-run release still fails closed.
LET $note_lines: LIST<STRING> = TEXT_LINES($notes)
LET $note_head: STRING = $note_lines.0
LET $note_date_ok: BOOL = TEXT_MATCH($note_head, "\\] - [0-9]{4}-[0-9]{2}-[0-9]{2}$")
IF $note_date_ok == false {
    ECHO "CHANGELOG [{{ $version }}] heading must end with ' - YYYY-MM-DD' (no TBD): {{ $note_head }}"
    EXIT 1
}

# Products resolve before anything publishes or tags: an empty list
# with binaries on fails here, so a bad resolution can never leave a
# pushed tag with no release behind it. Products arrive as
# RELEASE_BINS from the workflow (bins input, else the workspace
# metadata release_bins list); an empty list is a hard fail, never a
# silent single-product guess.
LET $bins: BOOL = BOOL_OR("{{ env:RELEASE_BINARIES }}", false)
LET $argline: STRING = ""
IF $bins {
    LET $raw: STRING = "{{ env:RELEASE_BINS }}"
    IF $raw == "" {
        ECHO "no release products: the workflow resolves RELEASE_BINS from bins: or workspace.metadata.oxdock release_bins"
        EXIT 1
    }
    LET $products: LIST<STRING> = TEXT_FIELDS($raw)
    LET $targets: LIST<STRING> = ["x86_64-unknown-linux-musl", "aarch64-unknown-linux-musl", "aarch64-apple-darwin", "x86_64-pc-windows-msvc", "aarch64-pc-windows-msvc"]
    LET $assets: LIST<STRING> = []
    FOR $p: STRING IN $products {
        FOR $t: STRING IN $targets {
            LIST_APPEND $assets "target/artifacts/{{ $p }}-{{ $t }}.tar.gz"
        }
    }
    LIST_APPEND $assets "target/artifacts/SHA256SUMS"
    LIST_APPEND $assets "target/artifacts/install.sh"
    LIST_APPEND $assets "target/artifacts/install.ps1"
    LIST_APPEND $assets "target/artifacts/install.oxfile"
    $argline = TEXT_JOIN($assets, " ")
}

[env:GITHUB_ACTIONS] {
    ECHO "::group::Publish workspace (dry-run)"
}
RUN ["cargo", "publish", "--workspace", "--dry-run"]
[env:GITHUB_ACTIONS] {
    ECHO "::endgroup::"
}

LET $dry: BOOL = BOOL_OR("{{ env:RELEASE_DRY_RUN }}", true)
IF !$dry {
    [env:GITHUB_ACTIONS] {
        ECHO "::group::Publish workspace"
    }
    LET $probedir: STRING = "{{ env:RUNNER_TEMP }}"
    IF $probedir == "" {
        $probedir = "/tmp"
    }
    LET $packages: LIST<MAP<ANY>> = CI_HELPERS::WORKSPACE_PACKAGES()
    LET $round: INT = 0
    LET $landed: BOOL = false
    # A successful round is convergence: transient errors and partial progress just run another.
    WHILE !$landed {
        $round = $round + 1
        IF $round == 10 {
            ECHO "workspace publish did not converge"
            EXIT 1
        }
        LET $excludes: STRING = ""
        LET $missing: INT = 0
        FOR $pkg: MAP<ANY> IN $packages {
            LET $pname: STRING = $pkg.name
            LET $pver: STRING = $pkg.version
            # Probes run outside the tree: cargo info inside the workspace resolves local packages instead of the registry.
            LET $probe: STRING = RUN 'cd "{{ $probedir }}" && cargo info "{{ $pname }}@{{ $pver }}" >/dev/null 2>&1 || printf OXDOCK_PUBLISH_MISSING'
            IF $probe == "" {
                # Exclude what landed: cargo has no skip-existing, so a resumed run fails on the first published crate.
                $excludes = "{{ $excludes }} --exclude {{ $pname }}"
            } ELSE {
                $missing = $missing + 1
            }
        }
        IF $missing == 0 {
            # Every member landed: nothing to publish, and cargo refuses an all-excluded invocation.
            $landed = true
        } ELSE {
            # Cargo keeps topological order over the rest and skips publish=false members itself.
            # Output goes to the round log, never the capture: progress text ahead of a failure would defeat the exact sentinel match.
            LET $round_out: STRING = RUN 'cargo publish --workspace{{ $excludes }} >"{{ $probedir }}/publish-round.log" 2>&1 || printf OXDOCK_PUBLISH_ROUND_FAILED'
            IF $round_out == "OXDOCK_PUBLISH_ROUND_FAILED" {
                ECHO "publish round failed; last output:"
                LET $diag: STRING = RUN cat "{{ $probedir }}/publish-round.log"
                ECHO "{{ $diag }}"
                ECHO "rechecking the registry"
                SLEEP 30s
            } ELSE {
                $landed = true
            }
        }
    }
    [env:GITHUB_ACTIONS] {
        ECHO "::endgroup::"
    }
    RUN ["git", "tag", "v{{ $version }}"]
    RUN ["git", "push", "origin", "v{{ $version }}"]

    # Release notes live under target/ (gitignored) so the notes file
    # itself never trips cargo's clean-tree publish guard.
    # Tag identity gate: the tag must point at HEAD before anything
    # destructive runs, so wrong-version binaries can never replace a
    # release under an old tag. `rev-list` dereferences lightweight and
    # annotated tags alike with no shell-hostile characters (a caret
    # suffix would break under cmd). Both sides carry identical
    # formatting, so the exact comparison holds. A moved or missing tag
    # fails here.
    LET $head: STRING = RUN git rev-parse HEAD
    LET $tagged: STRING = RUN git rev-list -n 1 "v{{ $version }}"
    ASSERT_EQ $head $tagged

    # Resume safety: a run that dies mid-release must converge on
    # re-dispatch. Deleting any existing release first makes creation
    # unconditional: first runs delete nothing, resumed runs replace the
    # partial release with a fresh one from current notes. `|| cd .`
    # swallows the delete when nothing exists (cmd has no `true`).
    RUN 'gh release delete "v{{ $version }}" --yes || cd .'

    # The archives are the build matrix output, downloaded by the
    # workflow into target/artifacts/ (see the asset contract in
    # release.yml): the tag carries the product version and every
    # product's tarballs ride along, so asset names stay static across
    # releases while differing per product and platform. Linux archives
    # are musl-static so they run in scratch containers; Windows
    # archives link the CRT statically so downloaders need no
    # VCRedist. The installer files ride along so bootstraps can run
    # logic matching their engine version instead of the checkout's
    # copy. The asset line resolved up front, before anything
    # published or tagged.
    IF !$bins {
        RUN ["gh", "release", "create", "v{{ $version }}", "--title", "{{ $version }}", "--notes-file", "target/release-notes.md"]
    } ELSE {
        RUN 'gh release create "v{{ $version }}" --title "{{ $version }}" --notes-file target/release-notes.md {{ $argline }}'
    }
} ELSE {
    ECHO "=== RELEASE NOTES ==="
    LET $preview: STRING = READ "target/release-notes.md"
    ECHO "{{ $preview }}"
    ECHO "=== END RELEASE NOTES ==="
    ECHO "Dry run complete: nothing published, no tag created."
}
