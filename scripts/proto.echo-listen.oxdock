IMPORT [STD, SSH]
WORKSPACE LOCAL

LET $server: MAP = SSH_SERVE(
    "127.0.0.1:2251",
    "test",
    "test123", {
        // "/temp" relative to workspace, not filesystem
        key_path: "/temp/test_key"
    }
)

ECHO "ssh proxy listening on {{ $server.addr }} (login test)"

LET $workers: LIST = []
LET $w: INT = 0
WHILE $w < 4 {
    LET $h: HANDLE = ASYNC {
        LET $run: BOOL = true
        WHILE $run {
            LET $c_in: PIPE
            LET $c_out: PIPE
            LET $acc: HANDLE = ASYNC { SSH_ACCEPT($server.server, $c_in, $c_out) }

            LET $pty: HANDLE = ASYNC { SSH_PTY_RUN($server.server, ["ssh", "-o", "BatchMode=yes", "orb"], 0, 0, $c_out, $c_in) }

            AWAIT $acc
            AWAIT $pty
        }
    }
    $workers = PUSH($workers, $h)
    $w = $w + 1
}

# Block main thread so background workers run indefinitely
AWAIT $workers
